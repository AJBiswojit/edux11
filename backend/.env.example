APP_NAME=MediXO EduX API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# While a student has an open exam sitting, access tokens last until sitting end + this grace (minutes).
EXAM_AUTH_GRACE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL (production). For local without Docker, sqlite:///./medixo.db also works.
# Shared RDS: point at the database, then pin objects to schema edux only.
DATABASE_URL=postgresql+psycopg2://MEdixo:llUNUFIiX1tk30CGmEYt@database-1-restored.cfck4skoe4h0.ap-south-2.rds.amazonaws.com:5432/postgres
DB_SCHEMA=edux
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origin the browser uses for /media/… figure crops (no /v1 suffix).
# Local (API on :8000):  http://localhost:8000
# Docker behind nginx:   leave EMPTY so URLs are /media/... on the same host
#                        (nginx proxies /media → api). Or set https://your-domain
PUBLIC_ORIGIN=http://localhost:8000
# Folder under the backend root that holds pushed crops (default: media).
MEDIA_DIR=media

# AI platform — leave empty to use deterministic fallback (same honesty as the SPA prototype)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=2048

PARENT_PORTAL_ENABLED=false
SEED_DEMO_USERS=true
DEMO_PASSWORD=aurora123

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Queue-based exam submission
QUEUE_ENABLED=true
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_SECONDS=5
QUEUE_STATUS_TTL_SECONDS=86400
QUEUE_WORKER_CONCURRENCY=4
